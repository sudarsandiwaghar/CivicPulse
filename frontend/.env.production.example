# =============================================================================
# CivicPulse Frontend — Production Environment Configuration Template
#
# INSTRUCTIONS:
# 1. Copy this file to frontend/.env.production before building the frontend:
#      cp frontend/.env.production.example frontend/.env.production
# 2. Adjust VITE_API_BASE_URL to match your production backend routing.
# 3. Configure optional municipal geospatial center coordinates and municipality name.
# 4. Build the production bundle:
#      npm run build
# =============================================================================

# --- Backend API Base URL ---
# For Cloudflare Pages deployed with Render backend, provide your Render service URL:
# Example: VITE_API_BASE_URL=https://civicpulse-backend.onrender.com/api/v1
# In Cloudflare Pages, set VITE_API_BASE_URL in Settings -> Environment Variables.
VITE_API_BASE_URL=https://civicpulse-backend.onrender.com/api/v1

# --- Municipal Geospatial Configuration (Optional) ---
# Default map center and city name for the municipal portal.
# If omitted or left blank, the portal displays a neutral national overview map.
VITE_MUNICIPAL_CITY=
VITE_MUNICIPAL_DEFAULT_LAT=
VITE_MUNICIPAL_DEFAULT_LNG=
