# =============================================================================
# CivicPulse — Environment Configuration Template
#
# Copy this file to .env and fill in the actual values.
# NEVER commit the .env file to version control.
#
# All values shown here are defaults or placeholders.
# Lines marked [REQUIRED] must be set before running the application.
# =============================================================================

# --- Application ---
APP_NAME=CivicPulse
APP_VERSION=0.1.0
APP_DEBUG=True

# --- API ---
API_V1_PREFIX=/api/v1

# --- Database (PostgreSQL) --- [REQUIRED]
DB_HOST=localhost
DB_PORT=5432
DB_USER=civicpulse
DB_PASSWORD=your_secure_password_here
DB_NAME=civicpulse

# --- JWT Authentication --- [REQUIRED]
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- File Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Logging ---
LOG_LEVEL=INFO
