# =============================================================================
# CivicPulse — Production Environment Configuration Template
#
# INSTRUCTIONS:
# 1. Copy this file to .env on your production server:
#      cp .env.production.example .env
# 2. Secure file permissions (Linux VPS):
#      chmod 600 .env
#      chown civicpulse:civicpulse .env
# 3. Replace all placeholder values marked [REQUIRED] with actual production secrets.
# 4. NEVER commit the real .env file to version control.
# =============================================================================

# --- Application Environment ---
APP_NAME=CivicPulse
APP_VERSION=0.8.0
# Set to 'production' to enforce strict security defaults (disables debug mode,
# disables auto-reloading, and restricts API documentation endpoints).
APP_ENV=production
APP_DEBUG=False

# API Documentation:
# When APP_ENV=production, interactive Swagger (/docs), ReDoc (/redoc), and
# schema (/openapi.json) are disabled by default for security. Set to True only
# if public API exploration is intentionally permitted in a staging environment.
ENABLE_DOCS=False

# --- API Prefix ---
API_V1_PREFIX=/api/v1

# --- Production Database (PostgreSQL 16+) --- [REQUIRED]
# The database host should be localhost (if running on same VPS) or your managed cluster IP.
DB_HOST=aws-0-[region].pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.[project-ref]
DB_PASSWORD=[YOUR_SUPABASE_DB_PASSWORD]
DB_NAME=postgres

# SQLAlchemy Connection Pool Configuration:
# - DB_POOL_SIZE: Number of persistent connections maintained per ASGI worker process.
#   Recommended: 10-20 connections per worker.
# - DB_MAX_OVERFLOW: Maximum number of temporary connections allowed beyond DB_POOL_SIZE.
# - DB_POOL_TIMEOUT: Seconds to wait for a connection before raising TimeoutError.
# - DB_SSLMODE: PostgreSQL SSL mode (disable, allow, prefer, require, verify-ca, verify-full).
#   Use 'require' or 'verify-full' for remote/managed database clusters.
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_SSLMODE=prefer

# --- Authentication & Security (JWT) --- [REQUIRED]
# Generate a cryptographically secure 64-character secret key:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=[GENERATE_A_64_CHAR_SECRET]
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Production Cross-Origin Resource Sharing (CORS) --- [REQUIRED]
# Whitelist only your production domain(s). Multiple origins can be comma-separated
# or specified as a JSON string array.
# Example: https://civicpulse.example.gov,https://admin.civicpulse.example.gov
CORS_ORIGINS=https://civicpulse.example.gov

# --- File Storage & Uploads ---
# Absolute path to uploads directory on the production server.
# Ensure the service user ('civicpulse') has read and write permissions (chmod 750).
UPLOAD_DIR=/var/www/civicpulse/uploads
MAX_UPLOAD_SIZE_MB=10

# --- Rate Limiting ---
# Maximum requests per minute per IP address for protected sensitive endpoints.
RATE_LIMIT_PER_MINUTE=60

# --- Production Logging ---
# Recommended: WARNING or INFO. Use WARNING for high-traffic environments to conserve disk space.
LOG_LEVEL=WARNING
